FROM node:22-slim AS builder
WORKDIR /app

ADD central-colmeia-v020.tar.gz /app/

RUN apt-get update \
 && apt-get install -y --no-install-recommends unzip ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY . /src
RUN chmod +x /src/v182-build.sh \
 && /src/v182-build.sh \
 && rm -rf /src

# Diagnóstico temporário e focalizado do cliente TSE já existente.
RUN echo '=== CE184_TSE_SYNC ===' \
 && grep -nE 'https?://|fetch\(|download|BASE|URL|request' /app/tse-sync.mjs | head -n 320 || true

FROM node:22-slim AS runtime
WORKDIR /app
COPY --from=builder /app /app

ENV NODE_ENV=production
RUN mkdir -p /app/runtime
LABEL org.opencontainers.image.title="Central Eleitoral Colmeia 2026" \
      org.opencontainers.image.version="1.8.3"
EXPOSE 8787
CMD ["node","server.mjs"]
