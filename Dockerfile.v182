FROM node:22-slim AS builder
WORKDIR /app

# A base histórica é expandida uma única vez.
ADD central-colmeia-v020.tar.gz /app/

# Dependências necessárias apenas durante a montagem dos ativos.
RUN apt-get update \
 && apt-get install -y --no-install-recommends unzip ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Uma única cópia de contexto + um único replay consolidado substituem
# a longa sequência histórica de COPY/RUN do Dockerfile legado.
COPY . /src
RUN chmod +x /src/v182-build.sh \
 && /src/v182-build.sh \
 && rm -rf /src

# Diagnóstico temporário e focalizado para integrar o leitor de BU à sessão operacional.
RUN echo '=== CE183_OPERATION_WIRING ===' \
 && (grep -nE 'api/results|api/whoami|sessionStorage|localStorage|Authorization|Bearer|<script[^>]+src=|<form|operator|operador' /app/public/operacao.html | head -n 260 || true) \
 && echo '=== CE183_RESULTS_CLIENTS ===' \
 && (grep -RniE "fetch\\(['\"]?/api/results|/api/results.*POST|Authorization.*Bearer|sessionStorage.*token" /app/public/*.js 2>/dev/null | head -n 260 || true)

FROM node:22-slim AS runtime
WORKDIR /app
COPY --from=builder /app /app

ENV NODE_ENV=production
RUN mkdir -p /app/runtime
LABEL org.opencontainers.image.title="Central Eleitoral Colmeia 2026" \
      org.opencontainers.image.version="1.8.2"
EXPOSE 8787
CMD ["node","server.mjs"]
